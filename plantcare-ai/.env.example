# ==============================================================================
# PlantCare AI - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and fill in your actual private credentials.
# NEVER commit your '.env' file or share your API keys in public repositories!
# ==============================================================================

# Flask Server Port
PORT=5000
FLASK_DEBUG=False

# ThingSpeak Cloud Settings
# Your ThingSpeak Channel ID (Found in Channel Settings -> Channel ID)
THINGSPEAK_CHANNEL_ID=YOUR_CHANNEL_ID_HERE

# Your ThingSpeak Read API Key (Required for private channels)
# Found in ThingSpeak -> Channels -> Your Channel -> API Keys -> Read API Key
THINGSPEAK_READ_API_KEY=YOUR_READ_API_KEY_HERE

# (Optional) ThingSpeak Write API Key (Used only by the Raspberry Pi collector script)
# The backend does NOT write to ThingSpeak, but you can reference it on the Pi
THINGSPEAK_WRITE_API_KEY=YOUR_WRITE_API_KEY_HERE

# ThingSpeak Polling / Cache TTL (in seconds)
# Free accounts require at least 15s between updates. Default backend cache is 20s.
THINGSPEAK_CACHE_TTL_SECONDS=20

# Demo / Simulation Mode
# Set to 'true' if you want to test the entire dashboard without live cloud data.
# Set to 'false' to fetch real telemetry from ThingSpeak Cloud.
DEMO_MODE=false

# CORS Allowed Origin (Default is the Vite dev server)
CORS_ORIGIN=http://localhost:5173
